# ── LLM: DeepSeek（OpenAI 兼容接口）──────────────────────────────────
# 申请地址: https://platform.deepseek.com
OPENAI_API_KEY=sk-your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_DOTENV_OVERRIDE=false
OPENAI_TRUST_ENV=false
OPENAI_TIMEOUT_SECONDS=60

# 使用的模型
FAST_LLM_MODEL=deepseek-chat
SMART_LLM_MODEL=deepseek-chat
# 如需推理模型（更强但更慢）:
# SMART_LLM_MODEL=deepseek-reasoner

# ── 搜索: DuckDuckGo（完全免费，无需 Key）────────────────────────────
RETRIEVER=duckduckgo

# ── 可选: 用 Tavily 替换搜索（更稳定，每月 1000 次免费）──────────────
# RETRIEVER=tavily
# TAVILY_API_KEY=tvly-your-key-here

# ── 服务配置 ────────────────────────────────────────────────────────
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3003

# VEGA runtime persistence
VEGA_RUNTIME_STORE=sqlite
VEGA_RUNTIME_DB_PATH=data/vega.db
VEGA_CHECKPOINT_DB_PATH=data/vega.db
# VEGA_RUNTIME_STORE=postgres
# VEGA_RUNTIME_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ciforce

# ── DashScope（阿里云百炼）─────────────────────────────────────────
# 产品视觉合成 agent 用，模型 wanx-background-generation-v2 v3
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# ── 阿里云 OSS（DashScope 拉参考图用，需 public-read bucket）────────
OSS_ACCESS_KEY_ID=LTAI-your-access-key
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket-name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# ── Auth（用户登录 / 邮箱验证）─────────────────────────────────────
# Cookie secure flag: 生产 https 设为 true，开发 http 留 false
AUTH_COOKIE_SECURE=false
# 邮箱验证码 sqlite db 路径（Docker 里落在 backend-data volume）
AUTH_DB_PATH=data/auth.db
# 阿里云邮件推送（开通后填入；当前为 console 占位，留空即可）
# ALIYUN_MAIL_AK=
# ALIYUN_MAIL_SK=
# MAIL_FROM=noreply@ciforce.cn
